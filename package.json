{
  "name": "webhook-viewer-universal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/runtime/node.ts",
    "start": "node --env-file=.env --import tsx src/runtime/node.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:create": "wrangler d1 create webhook-viewer",
    "cf:db:migrate:local": "wrangler d1 migrations apply webhook-viewer --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply webhook-viewer --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
